+/* Parse one response packet into the table. Returns true if the table grew. */
+static bool consume_packet(const unsigned char* buf, ssize_t len, struct answer_cb_ctx* ctx) {
+  if (len < 12)
+    return false;
+  if ((buf[2] & 0x80) == 0) /* not a response */
+    return false;
+
+  unsigned int ancount = ((unsigned int)buf[6] << 8) | buf[7];
+  unsigned int nscount = ((unsigned int)buf[8] << 8) | buf[9];
+  unsigned int arcount = ((unsigned int)buf[10] << 8) | buf[11];
+
+  size_t off = 12;
+  char name[NAME_LEN];
+
+  /* Skip the question section; we only ever ask the service type. */
+  unsigned int qdcount = ((unsigned int)buf[4] << 8) | buf[5];
+  for (unsigned int i = 0; i < qdcount; i++) {
+    off = dns_read_name(buf, (size_t)len, off, name, sizeof(name), 0);
+    if (off == 0)
+      return false;
+    if (off + 4 > (size_t)len)
+      return false;
+    off += 4; /* qtype, qclass */
+  }
+
+  unsigned int total = ancount + nscount + arcount;
+  for (unsigned int i = 0; i < total; i++) {
+    struct {
+      char owner[NAME_LEN];
+      unsigned int type;
+      unsigned int rdlen;
+      const unsigned char* rdata;
+    } rr;
+
+    off = dns_read_name(buf, (size_t)len, off, rr.owner, sizeof(rr.owner), 0);
+    if (off == 0)
+      return false;
+    if (off + 10 > (size_t)len)
+      return false;
+
+    rr.type = ((unsigned int)buf[off] << 8) | buf[off + 1];
+    /* unsigned int rr_class = ((unsigned int)buf[off+2] << 8) | buf[off+3]; */
+    rr.rdlen = ((unsigned int)buf[off + 8] << 8) | buf[off + 9];
+    off += 10;
+
+    if (off + rr.rdlen > (size_t)len)
+      return false;
+    rr.rdata = buf + off;
+    off += rr.rdlen;
+
+    switch (rr.type) {
+    case 12: { /* PTR: owner is the service type, rdata is the instance name */
+      char instance[NAME_LEN];
+      if (dns_read_name(buf, (size_t)len, (size_t)(rr.rdata - buf), instance, sizeof(instance), 0) == 0)
+        break;
+      lookup_instance(ctx, instance, true);
+      break;
+    }
+    case 33: { /* SRV */
+      char target[NAME_LEN];
+      if (rr.rdlen < 6)
+        break;
+      unsigned short port = (unsigned short)(((unsigned int)rr.rdata[4] << 8) | rr.rdata[5]);
+      if (dns_read_name(buf, (size_t)len, (size_t)(rr.rdata - buf) + 6, target, sizeof(target), 0) == 0)
+        break;
+      struct host_entry* e = lookup_instance(ctx, rr.owner, true);
+      if (e == NULL)
+        break;
+      snprintf(e->target, sizeof(e->target), "%s", target);
+      e->port = port;
+      e->have_srv = true;
+      break;
+    }
+    case 1: { /* A */
+      struct in_addr addr;
+      if (rr.rdlen < 4)
+        break;
+      memcpy(&addr, rr.rdata, 4);
+      remember_address(ctx, rr.owner, addr);
+      break;
+    }
+    default:
+      break;
+    }
   }
+
+  return true;
 }
 
