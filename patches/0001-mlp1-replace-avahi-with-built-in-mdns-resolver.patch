+  size_t off = 12;
+  off += dns_write_name(pkt + off, name);
+  pkt[off++] = (unsigned char)((type >> 8) & 0xFF);
+  pkt[off++] = (unsigned char)(type & 0xFF);
+  pkt[off++] = 0x00; pkt[off++] = 0x01; /* class IN */
+
+  return sendto(sock, pkt, off, 0, (const struct sockaddr*)maddr, sizeof(*maddr));
+}
+
+/* milliseconds since the boot clock, for window accounting below */
+static long now_ms(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+}
+
+/* Collect responses until the window closes. Returns early once cb says stop.
+ * The deadline is measured off a monotonic clock rather than counted down from
+ * the wait itself, so a busy responder cannot extend the window forever. */
+static void collect(int sock, int window_ms, struct answer_cb_ctx* ctx, bool (*cb)(struct answer_cb_ctx*)) {
+  long deadline = now_ms() + window_ms;
+
+  for (;;) {
+    long remaining = deadline - now_ms();
+    if (remaining <= 0)
+      return;
+
+    struct pollfd pfd;
+    pfd.fd = sock;
+    pfd.events = POLLIN;
+    pfd.revents = 0;
+
+    int rv = poll(&pfd, 1, (int)(remaining < 200 ? remaining : 200));
+    if (rv < 0) {
+      if (errno == EINTR)
+        continue;
+      return;
     }
+    if (rv == 0)
+      continue;
+
+    unsigned char buf[9000];
+    ssize_t len = recvfrom(sock, buf, sizeof(buf), 0, NULL, NULL);
+    if (len > 0)
+      consume_packet(buf, len, ctx);
+
+    if (cb && cb(ctx))
+      return;
   }
+}
 
