+static ssize_t send_query(int sock, const struct sockaddr_in* maddr, const char* name, unsigned int type) {
+  unsigned char pkt[512];
+  memset(pkt, 0, sizeof(pkt));
+
+  pkt[0] = 0x00; pkt[1] = 0x00; /* transaction id zero */
+  pkt[2] = 0x00; pkt[3] = 0x00; /* flags: query          */
+  pkt[4] = 0x00; pkt[5] = 0x01; /* one question          */
+  pkt[6] = pkt[7] = 0;          /* answer/authority/additional all zero */
