+/* ---------------------------------------------------------------- name codec
+ * Wire format: a sequence of labels, each a length byte followed by that many
+ * bytes, terminated by a zero-length label. A two-byte pointer whose top bits
+ * are 0xC0 follows a answer by referring to an earlier offset; the pointers are
+ * followed rather than copied, with a depth cap so a malformed packet cannot
+ * walk us in circles.
+ */
+static size_t dns_read_name(const unsigned char* msg, size_t len, size_t off,
+                            char* out, size_t out_len, int depth) {
+  size_t start = off;
+  size_t written = 0;
+  bool jumped = false;
+
+  if (out_len == 0)
+    return 0;
+  out[0] = 0;
+
+  if (depth > MAX_LABEL_DEPTH || off >= len)
+    return 0;
+
+  for (;;) {
+    if (off >= len)
+      return 0;
+    unsigned int b = msg[off];
+
+    if (b == 0) {
+      off++;
+      break;
+    }
+
+    switch (b & 0xC0) {
+    case 0x00: { /* ordinary label */
+      size_t label_len = b;
+      if (off + 1 + label_len > len)
+        return 0;
+      if (written + label_len + 1 >= out_len)
+        return 0;
+      if (written > 0) {
+        out[written] = '.';
+        written++;
+      }
+      memcpy(out + written, msg + off + 1, label_len);
+      written += label_len;
+      out[written] = 0;
+      off += 1 + label_len;
+      break;
+    }
+    case 0xC0: { /* compression pointer */
+      if (off + 1 >= len)
+        return 0;
+      size_t ptr = ((b & 0x3F) << 8) | msg[off + 1];
+      off += 2;
+      if (!jumped) {
+        /* Remember where parsing continues once the pointer is resolved. */
+        start = off;
+        jumped = true;
+      }
+      if (ptr >= len)
+        return 0;
+      char tail[NAME_LEN];
+      if (dns_read_name(msg, len, ptr, tail, sizeof(tail), depth + 1) == 0)
+        return 0;
+      size_t tail_len = strlen(tail);
+      if (written + tail_len + 1 >= out_len)
+        return 0;
+      if (written > 0 && tail_len > 0) {
+        out[written] = '.';
+        written++;
+      }
+      memcpy(out + written, tail, tail_len);
+      written += tail_len;
+      out[written] = 0;
+      return start;
+    }
+    default:
+      return 0; /* reserved label type */
+    }
+  }
+
+  return jumped ? start : off;
+}
+
+static size_t dns_write_name(unsigned char* dst, const char* name) {
+  unsigned char* p = dst;
+  const char* cur = name;
+
+  while (*cur == '.')
+    cur++;
+
+  while (*cur) {
+    const char* dot = strchr(cur, '.');
+    size_t n = dot ? (size_t)(dot - cur) : strlen(cur);
+    if (n == 0)
+      break;
+    if (n > 63)
+      n = 63;
+    *p++ = (unsigned char)n;
+    memcpy(p, cur, n);
+    p += n;
+    cur += n;
+    while (*cur == '.')
+      cur++;
+  }
+  *p++ = 0;
+  return (size_t)(p - dst);
+}
+
+/* ------------------------------------------------------------------- records */
+
+static struct host_entry* lookup_instance(struct answer_cb_ctx* ctx, const char* instance, bool create) {
+  for (int i = 0; i < *ctx->count; i++) {
+    if (strcmp(ctx->entries[i].instance, instance) == 0)
+      return &ctx->entries[i];
+  }
+  if (!create || *ctx->count >= MAX_HOSTS)
+    return NULL;
+
+  struct host_entry* e = &ctx->entries[*ctx->count];
+  memset(e, 0, sizeof(*e));
+  snprintf(e->instance, sizeof(e->instance), "%s", instance);
+  (*ctx->count)++;
+  return e;
+}
+
+static void remember_address(struct answer_cb_ctx* ctx, const char* hostname, struct in_addr addr) {
+  for (int i = 0; i < *ctx->count; i++) {
+    if (ctx->entries[i].have_srv && strcmp(ctx->entries[i].target, hostname) == 0) {
+      inet_ntop(AF_INET, &addr, ctx->entries[i].address, sizeof(ctx->entries[i].address));
+      ctx->entries[i].have_addr = true;
+    }
+  }
+}
